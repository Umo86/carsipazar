# Local development. Run `npm run db` to start this database.
DATABASE_URL=postgres://postgres@127.0.0.1:5433/postgres

# One-off setup at /api/setup?token=...
SETUP_TOKEN=choose-a-long-random-string
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=choose-a-strong-password
DEMO_PASSWORD=password-for-sample-logins
# Set to "art" to keep drawn patterns and skip the Pixabay downloads (works offline).
DEMO_IMAGES=
# Testing only: send the Pixabay downloads to this server (e.g. http://127.0.0.1:4010).
MEDIA_TEST_ORIGIN=

# Leave empty for demo payments. Add both to switch to Stripe.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
